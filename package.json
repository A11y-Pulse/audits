{
	"name": "@a11y-pulse/focus-appearance-audit",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "SEE LICENSE IN LICENSE.md",
	"exports": {
		".": "./src/index.ts",
		"./puppeteer": "./src/adaptors/puppeteer.ts"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"test:unit": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test": "npm run typecheck && npm run test:unit",
		"docs": "typedoc",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"pixelmatch": "^6.0.0",
		"pngjs": "^7.0.0"
	},
	"peerDependencies": {
		"puppeteer": "^24.15.0"
	},
	"peerDependenciesMeta": {
		"puppeteer": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@tsconfig/node22": "^22.0.2",
		"@types/node": "^22.0.0",
		"@types/pixelmatch": "^5.2.6",
		"happy-dom": "^20.9.0",
		"@types/pngjs": "^6.0.5",
		"puppeteer": "^24.15.0",
		"tsup": "^8.5.0",
		"typescript": "^6.0.2",
		"vitest": "^4.1.7"
	}
