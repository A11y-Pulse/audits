{
	"name": "@a11y-pulse/disclosure-operability-audit",
	"version": "0.0.0",
	"description": "WCAG 2.1.1 Keyboard and 4.1.2 Name, Role, Value audit that operates disclosure triggers (aria-expanded) with Enter and Space and checks that they open, close and report their state.",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE.md",
	"author": "A11y Pulse",
	"homepage": "https://github.com/A11y-Pulse/audits/tree/main/packages/disclosure-operability-audit#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/A11y-Pulse/audits.git",
		"directory": "packages/disclosure-operability-audit"
	},
	"bugs": {
		"url": "https://github.com/A11y-Pulse/audits/issues"
	},
	"keywords": [
		"accessibility",
		"a11y",
		"wcag",
		"keyboard",
		"aria-expanded",
		"disclosure",
		"audit"
	],
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsup && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"test:unit": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test": "npm run typecheck && npm run test:unit",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@a11y-pulse/browser-adaptor": "*"
	},
	"devDependencies": {
		"happy-dom": "^21.0.4",
		"playwright-core": "^1.65.0",
		"puppeteer": "^25.16.0"
	}
}
