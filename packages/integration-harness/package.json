		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@a11y-pulse/browser-adaptor": "*",
		"playwright-core": "^1.64.1",
		"puppeteer": "^25.14.0",
		"vitest": "^5.0.5"
	}
}
