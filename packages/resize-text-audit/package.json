{
	"name": "@a11y-pulse/resize-text-audit",
	"version": "0.0.0",
	"description": "WCAG 1.4.4 Resize Text audit that emulates 200% zoom and detects text that becomes clipped or overlapping.",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE.md",
	"author": "A11y Pulse",
	"homepage": "https://github.com/A11y-Pulse/audits/tree/main/packages/resize-text-audit#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/A11y-Pulse/audits.git",
		"directory": "packages/resize-text-audit"
	},
	"bugs": {
		"url": "https://github.com/A11y-Pulse/audits/issues"
	},
	"keywords": [
		"accessibility",
		"a11y",
		"wcag",
		"resize-text",
		"zoom",
		"puppeteer",
		"audit"
	],
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./puppeteer": {
			"source": "./src/adaptors/puppeteer.ts",
			"types": "./dist/adaptors/puppeteer.d.ts",
			"import": "./dist/adaptors/puppeteer.js"
		},
		"./playwright": {
			"source": "./src/adaptors/playwright.ts",
			"types": "./dist/adaptors/playwright.d.ts",
			"import": "./dist/adaptors/playwright.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsup && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"test:unit": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test": "npm run typecheck && npm run test:unit",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@a11y-pulse/browser-adaptor": "*",
		"@a11y-pulse/text-spacing-audit": "*"
	},
	"peerDependencies": {
		"playwright-core": ">=1.40",
		"puppeteer": "^25.16.0"
	},
	"peerDependenciesMeta": {
		"playwright-core": {
			"optional": true
		},
		"puppeteer": {
			"optional": true
		}
	},
	"devDependencies": {
		"happy-dom": "^21.0.4",
		"playwright-core": "^1.64.1",
		"puppeteer": "^25.16.0"
	}
}
